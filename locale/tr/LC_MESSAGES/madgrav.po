#: madgrav/gui/wxmmain.py:4376
msgid "Don't show any background image"
msgstr "Herhangi bir arka plan resmi gösterme"

#: madgrav/gui/wxmmain.py:4387
msgid "Don't show the measurement guides"
msgstr "Ölçüm kılavuzlarını gösterme"

#: madgrav/gui/wxmmain.py:4398
msgid "Don't show elements under the regmark branch"
msgstr "Regmark dalı altındaki öğeleri gösterme"

#: madgrav/gui/wxmmain.py:4410
msgid "Don't show the path that the laserhead has followed (blue line)"
msgstr "Lazer kafasının izlediği yolu gösterme (mavi çizgi)"

#: madgrav/gui/wxmmain.py:4422
msgid ""
"Don't show the small read circle showing the current laserhead position"
msgstr "Mevcut lazer kafası konumunu gösteren küçük kırmızı daireyi gösterme"

#: madgrav/gui/wxmmain.py:4432
