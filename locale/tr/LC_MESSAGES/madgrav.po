msgstr ""
"SVG Dönüştürme Talimatı girin ör. 'scale(1.49, 1, $x, $y)', döndür, taşı, "
"vb..."

#: madgrav/gui/wxmmain.py:3042
msgid "The entered command does nothing."
msgstr "Girilen komut hiçbir şey yapmaz."

#: madgrav/gui/wxmmain.py:3062
msgid ""
"Material must be jigged at 0,0.\n"
"How wide is your material (give units: in, mm, cm, px, etc)?"
msgstr ""
"Malzeme 0,0 noktasında sabitlenmiş olmalı.\n"
"Malzemeniz ne kadar geniş (birim belirtin: inç, mm, cm, px, vb)?"

#: madgrav/gui/wxmmain.py:3319
msgid "control various panes for main window"
