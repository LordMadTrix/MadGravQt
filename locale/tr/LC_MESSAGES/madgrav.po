#: madgrav/gui/wxmmain.py:4066
msgid "Clear Operations, Elements and Notes"
msgstr "İşlemleri, Öğeleri ve Notları Temizle"

#: madgrav/gui/wxmmain.py:4073
msgid "Clear existing elements and notes and open a new file"
msgstr "Mevcut öğeleri ve notları temizle ve yeni bir dosya aç"

#: madgrav/gui/wxmmain.py:4074 madgrav/gui/wxmmain.py:4087
#: madgrav/gui/wxmmain.py:5355
msgid " (keep the Shift-Key pressed to be asked for a target location)"
msgstr ""
" (hedef konum için sorulmasını istiyorsanız Shift tuşunu basılı tutun)"

#: madgrav/gui/wxmmain.py:4086
msgid "Import another file into the same project"
msgstr "Aynı projeye başka bir dosya aktar"

#: madgrav/gui/wxmmain.py:4094
msgid "Save the project as an SVG file (overwriting any existing file)"
msgstr "Projeyi SVG dosyası olarak kaydet (mevcut dosyanın üzerine yazar)"

#: madgrav/gui/wxmmain.py:4100
msgid "Save the project in a new SVG file"
msgstr "Projeyi yeni bir SVG dosyasında kaydet"

#: madgrav/gui/wxmmain.py:4304
msgid "Zoom to &Selected\tCtrl-Shift-B"
msgstr "Seçiliye Yakınlaştır\tCtrl-Shift-B"

#: madgrav/gui/wxmmain.py:4305 madgrav/gui/wxmscene.py:1549
msgid "Fill the scene area with the selected elements"
msgstr "Sahne alanını seçili öğelerle doldur"

#: madgrav/gui/wxmmain.py:4333
msgid "Show/Hide all panels/ribbon bar"
msgstr "Tüm panelleri/şerit çubuğunu göster/gizle"

#: madgrav/gui/wxmmain.py:4354
msgid "Don't show the origin indicator"
