msgstr "Sahne görüntüsünü etkin bir şekilde 180 derece döndür"

#: madgrav/gui/wxmmain.py:4488
msgid "Don't refresh the scene when requested"
msgstr "İstenildiğinde sahneyi yenileme"

#: madgrav/gui/wxmmain.py:4500
