msgstr "Panel konumlarını kilitle / panellerin taşınmasına izin ver"

#: madgrav/gui/wxmmain.py:3797
msgid "Reset pane positions to a default value"
msgstr "Panel konumlarını varsayılan değere sıfırla"

#: madgrav/gui/wxmmain.py:3935
msgid "Forget stored window positions"
