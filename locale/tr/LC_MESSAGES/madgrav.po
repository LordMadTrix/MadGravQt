msgstr "Tüm panelleri sıfırla ve varsayılan görünüme geri döndür"

#: madgrav/gui/wxmmain.py:3653
msgid "Theming information and assignments"
msgstr "Tema bilgileri ve atamalar"

#: madgrav/gui/wxmmain.py:3784
